// Transfer: send files and folders by link (Cloudflare Workers + R2 + D1).
// Sender pages (/send, /api/send/*) need Cloudflare Access (ALLOWED_EMAIL_DOMAIN).
// Recipient pages (/d/<id>) are public but unlisted, noindex, and need JavaScript.
// Files expire exactly 5 days after the upload completes.
{
  "name": "transfer",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "transfer.example.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "transfer" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "transfer", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }
  ],
  "send_email": [{ "name": "EMAIL", "allowed_destination_addresses": ["alice@example.com", "bob@example.com"], "allowed_sender_addresses": ["transfer@notify.example.com"] }],
  "triggers": { "crons": ["* * * * *"] },
  // Per-IP limit on /api/d/*/open. Free: no extra charge. The limit is per Cloudflare location.
  "ratelimits": [{ "name": "OPEN_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "vars": {
    "NOTIFY_TO": "alice@example.com,bob@example.com",
    "NOTIFY_FROM": "transfer@notify.example.com",
    "ALLOWED_EMAIL_DOMAIN": "example.com",
    "ACCESS_TEAM_DOMAIN": "REPLACE_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_ACCESS_AUD",
    "TTL_SECONDS": "432000",
    "PUBLIC_ORIGIN": "https://transfer.example.com"
  }
}
